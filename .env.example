# Optional backend proxy configuration for the n8n voice interpreter.
# From Docker Desktop, localhost is the backend container; use host.docker.internal for n8n on Windows.
N8N_VOICE_WEBHOOK_URL=
N8N_VOICE_WEBHOOK_TOKEN=
N8N_CONNECT_TIMEOUT_SECONDS=10
N8N_READ_TIMEOUT_SECONDS=30
N8N_IMAGE_READ_TIMEOUT_SECONDS=30
N8N_UML_IMAGE_WEBHOOK_URL=
N8N_UML_IMAGE_WEBHOOK_TOKEN=

# n8n runs in the same Docker Compose network as the backend.
N8N_VOICE_WEBHOOK_URL=http://n8n:5678/webhook/voice-interpret
N8N_VOICE_WEBHOOK_TOKEN=
N8N_CONNECT_TIMEOUT_SECONDS=10
N8N_READ_TIMEOUT_SECONDS=30
N8N_IMAGE_READ_TIMEOUT_SECONDS=30
N8N_UML_IMAGE_WEBHOOK_URL=http://n8n:5678/webhook/uml-image-interpret
N8N_UML_IMAGE_WEBHOOK_TOKEN=
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota
N8N_ENCRYPTION_KEY=
GEMINI_API_KEY=
JWT_SECRET=
JWT_EXPIRATION_SECONDS=86400
AI_CHAT_MAX_MESSAGE_LENGTH=4000

# Ollama is reached by the backend over the private Compose network.
# The model is downloaded explicitly into the persistent ollama_models volume.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
AI_ORCHESTRATOR_ENABLED=true
AI_ORCHESTRATOR_QUEUE_CAPACITY=2
AI_ORCHESTRATOR_TIMEOUT_SECONDS=120
